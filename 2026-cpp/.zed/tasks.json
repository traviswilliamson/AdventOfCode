[
  {
    "label": "Debug build",
    "command": "clang++",
    "args": ["-g", "main.cpp", "-std=c++23", "-o", "bin/debug/main.exe"],
  },
  {
    "label": "Release build",
    "command": "clang++",
    "args": ["-o3", "-DNDEBUG", "-std=c++23", "main.cpp", "-o", "bin/release/main.exe"],
  },
  {
    "label": "Run Release version",
    "command": "x64/release/main.exe",
  },
  {
    "label": "Build & Run Release version",
    "command": "clang++ -o3 -DNDEBUG -std=c++23 main.cpp -o bin/release/main.exe; bin/release/main.exe",
  }
]
