[
  {
    "label": "Debug build",
    "command": "cmake",
    "args": ["--build", "--preset", "debug"]
  },
  {
    "label": "Release build",
    "command": "cmake",
    "args": ["--build", "--preset", "release"]
  },
  {
    "label": "Run Release version",
    "command": "build/release/AdventOfCode.exe"
  },
  {
    "label": "Build & Run Release version",
    "command": "cmake --build --preset release; build/release/AdventOfCode.exe"
  },
]
